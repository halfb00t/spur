__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
build/
dist/
.pytest_cache/
.ruff_cache/
web/node_modules/
# generated models
*.stl
*.step
*.stp

# agent worktrees (make worktree.new)
/.claude/worktrees/

# GSD per-run dispatch sentinel (isolation decision + timestamp of the last run), not config
.gsd/

# research-tool response cache (hashed JSON), regenerated on demand
/.planning/research/.cache/

# coverage data files: one per process because [tool.coverage.run] parallel = true,
# combined by pytest-cov after the run. Not a bare .coverage*, which would also hide a
# future .coveragerc.
.coverage
.coverage.*
